# ---------------------------------------------------------------
# Jata Cafe - environment configuration
# Copy this file to `.env.local` and fill in real values.
#
# Target stack: Next.js on Vercel + Supabase (Postgres & Storage).
# Every value below is found in the Supabase dashboard; the exact
# location is noted per variable.
# ---------------------------------------------------------------


# ===============================================================
# Site
# ===============================================================

# Public base URL of the live site (SEO canonical tags, Open Graph,
# JSON-LD, robots.txt, sitemap.xml).
#
# !! BUILD-TIME VARIABLE !!  NEXT_PUBLIC_* values are inlined into the
# compiled output during `next build`, not read when the server starts.
# It must be set in Vercel BEFORE the first production build. Adding it
# afterwards changes nothing until you redeploy, and until then your
# canonical URLs and sitemap silently keep the hardcoded fallback.
NEXT_PUBLIC_SITE_URL=https://jatacafe.co.ke


# ===============================================================
# Supabase - project
# Dashboard: Project Settings -> API Keys
# ===============================================================

# Base URL of your Supabase project. Not a credential - it is a public
# hostname, and next/image needs it in remotePatterns to render uploaded
# images. Shown at the top of Project Settings -> API, and it is simply
# https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Elevated server-side key, used only to upload to Supabase Storage.
#
# WHICH KEY TO COPY: Supabase replaced the old key model. Projects created
# after November 2025 have NO `service_role` key at all - instead you will
# find a "secret key" that starts with `sb_secret_`. Create one if the list
# is empty, and paste it here. If your project is older and still shows a
# legacy `service_role` JWT, that works too.
#
# !! SERVER ONLY. NEVER RENAME THIS TO START WITH NEXT_PUBLIC_ !!
# This key bypasses Row Level Security completely. With a NEXT_PUBLIC_
# prefix it is inlined into the browser bundle, and anyone who views
# source gets full read/write access to your database.
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe public key (`sb_publishable_...`, or a legacy `anon` JWT).
#
# NOT CURRENTLY USED by any code: the app talks to Postgres directly over
# the connection string below, and Storage uploads use the secret key
# above, so nothing goes through PostgREST. Left here as a placeholder in
# case client-side Supabase access is added later. Safe to leave empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ===============================================================
# Supabase - Postgres connection
# Dashboard: the green "Connect" button in the top bar of your project.
# The modal lists three options: Direct connection, Session pooler and
# Transaction pooler. You need two of them (see below).
# ===============================================================

# Pooled connection string. Copy it verbatim from the dashboard rather
# than assembling it by hand - the host differs per region.
#
# Use the "Transaction pooler" entry, which ends in :6543.
# Do NOT use the direct connection on :5432, and do NOT use the session
# pooler: serverless functions open a connection per invocation and only
# transaction mode survives that. Prepared statements must be disabled
# on transaction mode (the app does this already).
#
# Shape:  postgresql://postgres.<project-ref>:<db-password>@<host>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Unpooled connection, used ONLY by `npm run db:migrate` and `npm run db:seed`.
#
# Schema changes (CREATE TABLE, CREATE INDEX) and the seed transaction do not
# run reliably through the transaction pooler, so these one-off commands need a
# direct or session-mode connection instead. Copy the "Direct connection" entry
# (port 5432) from the same dashboard page.
#
# Local only - this does NOT need to be set in Vercel. If you apply the schema
# by pasting supabase/migrations/0001_init.sql into the Supabase SQL editor
# instead, you can leave this empty entirely.
MIGRATION_DATABASE_URL=


# ===============================================================
# Supabase - Storage (owner-uploaded menu & banner images)
# Dashboard: Storage -> Buckets
# ===============================================================

# Bucket name for owner uploads. Create it with public read access.
# Uploads are resized to WebP server-side before being stored; the free
# tier allows only 1 GB of file storage, so unresized phone photos would
# fill it within a few dozen images.
SUPABASE_STORAGE_BUCKET=uploads


# ===============================================================
# First-run admin account
# ===============================================================

# Used ONCE, when the seed script runs against a fresh database. After
# the account exists these values are ignored forever.
#
# Set SEED_ADMIN_PASSWORD to something of your own BEFORE seeding. The
# old default was committed to this repo, so it is public knowledge.
# The account is created with must_change_password = 1, so the first
# login redirects to a change-password screen. The new password needs at
# least 10 characters with an uppercase letter, a lowercase letter and a
# digit. Changing it signs out every existing session.
SEED_ADMIN_EMAIL=owner@jatacafe.co.ke
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Jata Cafe Manager


# ===============================================================
# Optional
# ===============================================================

# Google Search Console verification token. Emitted as a <meta> tag only
# when set; leave empty to omit it.
GOOGLE_SITE_VERIFICATION=

# Reserved. No code reads this today.
#
# Admin sessions do not need a secret: a 32-byte random token is
# generated per session, only its SHA-256 hash is stored in the database,
# and the raw token lives in an httpOnly cookie. There is no signed
# payload to verify. Set a real value anyway so the variable is already
# provisioned if signed state is added later.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=


# ===============================================================
# Removed
# ===============================================================

# DATABASE_PATH - obsolete. It pointed at the local SQLite file, which
# Supabase Postgres replaces. Delete it from any .env.local you still
# have lying around; nothing reads it after the migration.
