# ---------------------------------------------------------------
# Jata Cafe - environment configuration
# Copy this file to `.env.local` and fill in real values.
# ---------------------------------------------------------------

# Public base URL of the live site (used for SEO canonical tags + sitemap).
NEXT_PUBLIC_SITE_URL=https://jatacafe.co.ke

# Where the SQLite database file lives.
# On a VPS / Railway / Fly.io point this at a mounted persistent volume.
DATABASE_PATH=./data/jata.sqlite

# Secret used to sign admin session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# First-run admin account. Only used the very first time the database is created.
SEED_ADMIN_EMAIL=admin@jatacafe.co.ke
SEED_ADMIN_PASSWORD=ChangeMe@Jata2026
SEED_ADMIN_NAME=Jata Cafe Manager

# Optional: Google Search Console verification token for local SEO setup.
GOOGLE_SITE_VERIFICATION=
